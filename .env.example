# APEX CORE environment variables. PLACEHOLDERS ONLY: never commit real keys.
#
# APEX CORE does NOT read a .env file from your project or working directory
# (a repository you clone must not be able to redirect your API traffic).
# Use one of these instead:
#   * paste the key into `apex setup` (it goes to the OS keyring or the private
#     credentials file below), or
#   * export the variables in your shell profile (see README.md), or
#   * run `apex config set-key <provider>` (OS keyring), or
#   * copy the lines you need into the private credentials file shown by
#     `apex config path` (for example ~/.config/apex-core/.env on Linux).

# --- Provider API keys (only the ones you use) -------------------------------
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
DEEPSEEK_API_KEY=your-deepseek-key-here
GEMINI_API_KEY=your-gemini-key-here
MISTRAL_API_KEY=your-mistral-key-here
OPENROUTER_API_KEY=your-openrouter-key-here
GROQ_API_KEY=your-groq-key-here
# Ollama and LM Studio run locally and need no key.

# --- Optional APEX CORE overrides (environment only, not the credentials file) --
# APEX_PROVIDER=openai              # provider for this shell session
# APEX_MODEL=your-model-id          # model for this shell session
# APEX_CONFIG_DIR=/path/to/config   # where config.toml lives
# APEX_DATA_DIR=/path/to/data       # where history, memory, and input history live
# APEX_NO_KEYRING=1                 # never touch the OS keyring
# APEX_SIMPLE_INPUT=1               # plain line input in the chat (unusual terminals)
# APEX_AGENT__MAX_STEPS=20          # any config key: APEX_<SECTION>__<KEY>
